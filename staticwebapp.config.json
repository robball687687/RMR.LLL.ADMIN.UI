{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/*.css",
      "/*.js",
      "/*.png",
      "/*.jpg",
      "/*.jpeg",
      "/*.svg",
      "/*.ico",
      "/*.txt",
      "/*.woff",
      "/*.woff2"
    ]
  },
  "routes": [
    { "route": "/f/*", "rewrite": "/index.html" },
    { "route": "/*", "rewrite": "/index.html" }
  ]
}
